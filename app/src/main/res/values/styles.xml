<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 设置全屏 -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
    <!-- 基础应用主题 -->
    <style name="Theme.MyApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 自定义主题颜色 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="Theme.AppCompat.NoActionBar.FullScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Text.Bold.16sp" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="Button.TransparentBackground" parent="Widget.AppCompat.Button">
        <item name="android:background">@null</item>
    </style>
    <!-- 输入框样式 -->
    <style name="InputLayoutStyle">
        <item name="boxStrokeColor">@color/purple_500</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintTextColor">@color/purple_500</item>
    </style>

    <!-- 功能按钮样式 -->
    <style name="FunctionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/purple_500</item>
        <item name="strokeColor">@color/purple_500</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="NavigationButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_cruise_purple</item>
        <item name="android:textColor">@color/nav_button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ColoredButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:layout_margin">4dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="FunctionButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/purple_500</item>
        <item name="backgroundTint">@color/button_background</item>
        <item name="cornerRadius">4dp</item>
    </style>
    <style name="TabButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:background">#FFFFFF</item>
    </style>
    <style name="DialogAnimation">
<!--    动画样式调用 与 设置    -->
<!--    <item name="android:windowEnterAnimation">@anim/dialog_enter</item>-->
<!--    <item name="android:windowExitAnimation">@anim/dialog_exit</item>-->
<!--    <item name="android:windowEnterAnimation">@anim/slide_up</item>-->
<!--    <item name="android:windowExitAnimation">@anim/slide_down</item>-->
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="SpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/spinner_background</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="BatteryProgressStyle">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/progress_battery_layer</item>
        <item name="android:minHeight">20dp</item>
        <item name="android:maxHeight">20dp</item>
    </style>
    <!-- 基本按钮样式 -->
    <style name="BaseButtonStyle" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- MaterialButton 专用样式 -->
    <style name="NoCapsMaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- 文本颜色选择器 -->

    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>
    <style name="NoArrowSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>