<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#303350">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="12dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- 左侧信息区 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginStart="30dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivWaypoint"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_waypoint"
                app:tint="#2196F3" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvPointName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/point_name_default"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvOperation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/Lifting5"
                    android:textColor="#B0B8D1"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧操作区 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="30dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnStartJack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Start"
                android:textSize="22sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                style="@style/NoCapsMaterialButton"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:textSize="22sp"
                android:backgroundTint="#FFC107"
                android:textColor="#FFFFFF"
                style="@style/NoCapsMaterialButton"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textSize="22sp"
                android:backgroundTint="#FF5252"
                style="@style/NoCapsMaterialButton"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>