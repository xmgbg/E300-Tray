<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_color"
    tools:context=".ui.SettingActivity">

    <!-- 返回按钮 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_button"
        android:elevation="10dp"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_return"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 左侧按钮区域 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        android:layout_marginTop="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/optionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">




        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLocationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Position_setting"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/setting_location_small"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"  />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBasicSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Basic_setup"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/setting_basic_small"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVoiceSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Language_settings"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/setting_voice_small"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnElevatorSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/elevator_settings"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/setting_elevator_small"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <!-- 呼叫设置按钮 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCallSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Call_settings_dialog_title"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/setting_callbox"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <!-- 门锁设置按钮 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDoorLockSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Door_lock_settings"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/ic_lock"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <!-- 用户管理按钮 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUserManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_management"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/ic_user_management"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <!-- RFID管理按钮 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRfidManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rfid_management"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/ic_rfid_card"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMapAreaSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/area_settings_title"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/ic_area_settings"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAvoidanceSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/avoidance_settings_title"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/ic_avoidance_settings"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShelfSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Shelf_setup"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/ic_shelf"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMapSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Map_settings"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/setting_map_small"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHistoryNewsSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_dialog_title"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/ic_history"
            android:paddingLeft="20dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>
            
        <!--<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRobotRunSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/robot_run_dialog_title"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/ic_robot_run"
            android:paddingLeft="19dp"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>-->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeviceSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Regarding_the_equipment"
            android:textSize="22sp"
            android:stateListAnimator="@null"
            android:background="@drawable/setting_button_bg_selector"
            android:drawableLeft="@drawable/setting_device_small"
            android:layout_marginBottom="16dp"
            style="@style/BaseButtonStyle"/>
        </LinearLayout>
    </ScrollView>

    <!-- 内容区域 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="15dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toEndOf="@id/scrollView"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Setting_interface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/time_text_color"
        android:layout_marginStart="0dp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintHorizontal_bias="0.0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
