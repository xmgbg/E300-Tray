<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/locationSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp">

    <!-- 顶部选项卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="120dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabPointSetting"
                style="@style/TabButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/point_location_tab"
                android:textSize="22dp"
                android:textColor="@drawable/text_color_selector"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/black" />

            <View
                android:id="@+id/underlinePoint"
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@color/purple_500"
                android:visibility="invisible" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="120dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabFixedLocation"
                style="@style/TabButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/fixed_location_tab"
                android:textSize="22dp"
                android:textColor="@drawable/text_color_selector"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/black" />

            <View
                android:id="@+id/underlineFixed"
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@color/purple_500"
                android:visibility="invisible" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Current Map, Building and Floor Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/card_stroke"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_map_label"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCurrentMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="@color/switch_thumb"
            android:layout_marginHorizontal="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_building_label"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCurrentBuilding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="@color/switch_thumb"
            android:layout_marginHorizontal="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_floor_label"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="end" />

            <TextView
                android:id="@+id/tvCurrentFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="4dp"
                android:layout_gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 公共操作栏 -->
    <LinearLayout
        android:id="@+id/commonActions"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddLocation"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_location"
                android:textSize="20dp"
                android:textColor="@color/blue_500"/>

            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="8dp"
                android:background="#E0E0E0"
                android:layout_gravity="center_vertical"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFetchFromMap"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fetch_location_from_map"
                android:textSize="20dp"
                android:textColor="@color/blue_500"/>

            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="8dp"
                android:background="#E0E0E0"
                android:layout_gravity="center_vertical"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadLocation"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="@string/upload_location"
                android:textSize="20dp"
                android:textColor="@color/blue_500"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 动态内容区域 -->
    <FrameLayout
        android:id="@+id/dynamicContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <!-- 普通位置点区域 -->
        <LinearLayout
            android:id="@+id/workPointsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 建筑选项卡 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabBuildingTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:tabMode="scrollable"
                app:tabGravity="fill"
                android:visibility="gone"/>

            <!-- 楼层选项卡 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabFloorTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:tabMode="scrollable"
                app:tabGravity="fill"/>

            <!-- 工作点位列表 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWorkPoints"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <!-- 工作点位无数据指示器 -->
                <LinearLayout
                    android:id="@+id/workNoDataContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivWorkNoData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_nodata"
                        android:scaleType="centerInside"
                        android:adjustViewBounds="true"
                        android:layout_gravity="center"
                        android:maxWidth="200dp"
                        android:maxHeight="200dp" />

                    <TextView
                        android:id="@+id/tvWorkNoData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="italic"
                        android:textSize="22dp"
                        android:layout_marginTop="8dp"
                        android:textColor="#9DDAFF"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- 固定位置区域 -->
        <FrameLayout
            android:id="@+id/fixedLocationContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- 建筑选项卡 -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabFixedBuildingTabs"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:tabMode="scrollable"
                    app:tabGravity="fill"
                    android:visibility="gone"/>

                <!-- 固定点楼层选项卡 -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabFixedFloorTabs"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:tabMode="scrollable"
                    app:tabGravity="fill"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFixedLocation"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <!-- 固定位置的无数据指示器 -->
                    <LinearLayout
                        android:id="@+id/fixedNoDataContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:id="@+id/ivFixedNoData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_nodata"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true"
                            android:layout_gravity="center"
                            android:maxWidth="200dp"
                            android:maxHeight="200dp" />

                        <TextView
                            android:id="@+id/tvFixedNoData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="italic"
                            android:textSize="22dp"
                            android:layout_marginTop="8dp"
                            android:textColor="#9DDAFF"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>