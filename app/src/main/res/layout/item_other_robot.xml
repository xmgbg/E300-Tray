<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginBottom="8dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/traffic_robot_item_label"
            android:textSize="13sp"
            android:textColor="@color/text_color"/>

        <Button
            android:id="@+id/btnRemoveRobot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:background="@drawable/button_bg_selector"
            android:textColor="@color/white"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <EditText
            android:id="@+id/etRobotId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/robot_id"
            android:padding="8dp"
            android:background="@drawable/edit_text_bg"
            android:textSize="13sp"
            android:inputType="number"
            android:layout_marginEnd="4dp"/>

        <EditText
            android:id="@+id/etRobotChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/lora_channel"
            android:padding="8dp"
            android:background="@drawable/edit_text_bg"
            android:textSize="13sp"
            android:inputType="number"
            android:maxLength="3"
            android:layout_marginEnd="4dp"/>

        <EditText
            android:id="@+id/etRobotAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/lora_address"
            android:padding="8dp"
            android:background="@drawable/edit_text_bg"
            android:textSize="13sp"
            android:inputType="text"
            android:maxLength="2"/>

    </LinearLayout>

</LinearLayout>
