<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvElevatorInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="26sp"
            android:textColor="@drawable/text_color_selector"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnElevatorControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elevator_control"
            android:textSize="22sp"
            android:textColor="@color/blue_500"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnElevatorSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elevator_settings_dialog_title"
            android:layout_marginEnd="8dp"
            android:textSize="22sp"
            android:textColor="@color/blue_500"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFloors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingLeft="16dp"/>
</LinearLayout>