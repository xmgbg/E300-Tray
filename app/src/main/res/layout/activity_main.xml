    <!--  主内容布局区域  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="200dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintHeight_percent="0.8">

        <!-- 第一行：功能模式按钮 -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <!-- 配送模式 - 使用字符串资源 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDelivery"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:text="@string/delivery_mode"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:drawableTint="@android:color/white"
                android:drawableTop="@drawable/main_ic_delivery"
                android:paddingTop="74dp"
                android:drawablePadding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_cruise_purple"
                style="@style/BaseButtonStyle"/>
            <!-- 巡航模式 - 使用字符串资源 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCruise"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:text="@string/cruise_mode"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:drawableTint="@android:color/white"
                android:drawableTop="@drawable/main_cruise_small"
                android:drawablePadding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_setting_red"
                style="@style/BaseButtonStyle"/>

            <LinearLayout
                android:id="@+id/jack_time_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal">
                <!-- 顶升模式 - 使用字符串资源 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnJack"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:text="@string/jack_mode"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:drawableTint="@android:color/white"
                    android:drawableTop="@drawable/ic_up"
                    android:drawablePadding="8dp"
                    android:paddingTop="68dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cruise_purple"
                    style="@style/BaseButtonStyle"/>

                <!-- 时间显示 -->
                <LinearLayout
                    android:id="@+id/timeContainer"
                    android:layout_width="270dp"
                    android:layout_height="210dp"
                    android:orientation="horizontal"
                    android:padding="30dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_time_blue">


                    <!-- 左侧：时间文本区域 -->
                    <LinearLayout
                        android:id="@+id/textContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <!--                    <TextView-->
                        <!--                        android:id="@+id/tvTimeLabel"-->
                        <!--                        android:layout_width="wrap_content"-->
                        <!--                        android:layout_height="wrap_content"-->
                        <!--                        android:text="@string/current_time"-->
                        <!--                        android:textSize="23sp"-->
                        <!--                        android:textColor="@android:color/white" />-->

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14:30:45"
                            android:textSize="42sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2023年11月15日"
                            android:textSize="22sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <!-- 右侧：动态时钟图标 -->
                    <com.ezhan.amr.ui.ClockView
                        android:id="@+id/clockView"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginRight="30dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 第二行：系统状态区域 -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="14dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/row1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="428dp"
                android:layout_height="210dp"
                android:orientation="horizontal"
                android:paddingRight="60dp"
                android:background="@drawable/bg_status_panel_bluegray">
                <!-- 系统状态面板 -->
                <LinearLayout
                    android:id="@+id/statusPanel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="18dp"
                    android:padding="20dp">
                    <!-- 使用字符串资源 -->
                    <!--                <TextView-->
                    <!--                    android:id="@+id/tvSystemStatusTitle"-->
                    <!--                    android:layout_width="wrap_content"-->
                    <!--                    android:layout_height="wrap_content"-->
                    <!--                    android:text="@string/system_status"-->
                    <!--                    android:textSize="20sp"-->
                    <!--                    android:textColor="@android:color/black"-->
                    <!--                    android:textStyle="bold"-->
                    <!--                    android:layout_marginBottom="8dp" />-->

                    <!-- 导航状态动态显示 -->
                    <TextView
                        android:id="@+id/tvNavStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_status_unknown"
                        android:textSize="18sp"
                        android:textColor="@android:color/black" />

                    <!-- 异常状态动态显示 -->
                    <TextView
                        android:id="@+id/tvErrorStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/error_status_unknown"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvPoseProbability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text= "@string/pose_probability_unknown"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvCurrentPosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/current_position_default"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 回桩/返航按钮 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="8dp">

                <!-- 回桩充电按钮 - 使用字符串资源 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReturnToCharge"
                    android:layout_width="270dp"
                    android:layout_height="99dp"
                    android:text="@string/return_to_charge"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:drawableLeft="@drawable/main_charge_small"
                    android:drawablePadding="8dp"
                    android:background="@drawable/bg_cruise_purple"
                    style="@style/BaseButtonStyle"/>

                <!-- 回驻车点按钮 - 使用字符串资源 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnReturnToHome"
                    android:layout_width="270dp"
                    android:layout_height="99dp"
                    android:text="@string/return_to_home"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:drawableLeft="@drawable/main_return_small"
                    android:drawablePadding="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_cruise_purple"
                    style="@style/BaseButtonStyle"/>
            </LinearLayout>

            <!-- 系统设置按钮 - 使用字符串资源 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSetting"
                android:layout_width="210dp"
                android:layout_height="208dp"
                android:text="@string/system_settings"
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:drawableTint="@android:color/white"
                android:drawableTop="@drawable/main_setting_small"
                android:drawablePadding="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_setting_red"
                style="@style/BaseButtonStyle"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 导航状态提示层 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/gifView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="0dp"
            android:elevation="10dp"
            android:adjustViewBounds="true"
            android:padding="0dp"/>

        <!-- 导航状态文本 - 使用字符串资源 -->
        <TextView
            android:id="@+id/tvNavigationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="64sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="200dp"
            android:padding="16dp"
            android:elevation="11dp"
            android:visibility="gone"/>
        <ImageView
            android:id="@+id/pingCoverView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scaleType="centerCrop"
            android:background="#80000000"/>
<!--            android:contentDescription="@string/controller_connect_success"-->
    </FrameLayout>

    <FrameLayout
        android:id="@+id/startTip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:ignore="MissingConstraints">

        <!-- 黑色蒙版层 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:clickable="true"/>

        <!-- 内容容器 - 所有原有内容放在这里 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 应用Logo -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/delivery_logo"/>

            <!-- 提示 -->
            <TextView
                android:id="@+id/tvLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <!-- 水平进度条 -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:max="100"
                android:indeterminate="false"
                />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
