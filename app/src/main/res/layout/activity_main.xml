            <!-- 充电状态图标 -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp">
                <!-- 电池外壳 -->
                <ImageView
                    android:id="@+id/batteryOutline"
                    android:layout_width="32dp"
                    android:layout_height="22dp"
                    android:layout_marginLeft="4dp"
                    android:src="@drawable/ic_battery_outline"
                    android:adjustViewBounds="true"/>
                <!-- 电量进度条 - 在边框内部 -->
                <ProgressBar
                    android:id="@+id/batteryProgress"
                    style="@style/BatteryProgressStyle"
                    android:layout_width="21dp"
                    android:layout_height="16dp"
                    android:layout_centerInParent="true"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_battery_layer"
                    android:indeterminate="false"/>
                <ImageView
                    android:id="@+id/chargingIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/ic_ischarging"
                    android:visibility="gone"/>
            </RelativeLayout>
            <!-- 电量文本 -->
            <TextView
                android:id="@+id/batteryLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/batteryOutline"
                android:text="0%"
                android:textSize="14sp"
                android:textColor="@color/time_text_color"/>
