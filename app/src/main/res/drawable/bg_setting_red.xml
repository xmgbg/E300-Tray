<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C62828"/> <!-- 比主色稍深 -->
            <corners android:radius="14dp"/>
            <stroke
                android:width="1dp"
                android:color="#B71C1C"/> <!-- 深色边框增加立体感 -->
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp"/>
        </shape>
    </item>
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#EF5350"
                android:endColor="#E53935"
                android:angle="270"/> <!-- 渐变增加立体感 -->
            <corners android:radius="14dp"/>
            <stroke
                android:width="1dp"
                android:color="#D32F2F"/> <!-- 边框增加饱满感 -->
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp"/>
        </shape>
    </item>
</selector>