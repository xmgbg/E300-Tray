<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态（深紫色，增加凹陷感） -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#673AB7" /> <!-- 比主色深20% -->
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#5E35B1" /> <!-- 深色边框增强立体感 -->
            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />
        </shape>
    </item>

    <!-- 默认状态（渐变+阴影效果，更饱满） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#7C4DFF"
                android:endColor="#651FFF"
                android:angle="45" /> <!-- 从上到下的渐变 -->
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#7C4DFF" /> <!-- 边框增强立体感 -->
            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />
        </shape>
    </item>
</selector>