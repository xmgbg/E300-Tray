<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_tab_indicator.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底部指示线 -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="2dp" />  <!-- 线高 -->
            <solid android:color="#9C27B0"/> <!-- 紫色 -->
        </shape>
    </item>

    <!-- 背景分割线 -->
    <item android:end="1dp" android:start="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#E0E0E0"/> <!-- 中性灰 -->
        </shape>
    </item>
</layer-list>