<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" /> <!-- 浅蓝色 -->
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#2196F3" /> <!-- 蓝色边框 -->
        </shape>
    </item>

    <!-- 选中/聚焦状态 -->
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2196F3" /> <!-- 中等蓝色 -->
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#2196F3" />
        </shape>
    </item>

    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#464C61" /> <!-- 浅灰色 -->
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>