<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 统一圆角（16dp是常见值） -->
    <corners android:radius="16dp" />

    <!-- 纯色背景（示例用白色） -->
    <solid android:color="#FFFFFF" />

    <!-- 可选：轻微阴影 -->
    <stroke
        android:width="1dp"
        android:color="#20000000" />
</shape>